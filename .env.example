# Copy to .env and edit. Every value has a sensible default except DOMAIN/BASE_URL for a real server.

# Public address (used in emails and links). On a laptop keep http://localhost:3000.
BASE_URL=https://flow.loyalstring.com
DOMAIN=flow.loyalstring.com

# Demo data: 1 loads sample customers, tickets, deals and KPI history for evaluation. Use 0 for the real system.
LOYALFLOW_DEMO=0

# Starter password for the seeded employee accounts (everyone must change it at first sign-in when demo is off).
SEED_PASSWORD=Welcome@LoyalFlow1
EMAIL_DOMAIN=loyalstring.com

# Sessions: set a long random string (openssl rand -base64 48). If empty, one is generated and stored in the data folder.
SESSION_SECRET=
SESSION_DAYS=14
API_TOKEN_DAYS=90

# Email. console = print to the server log (laptop/testing). smtp = Microsoft 365 (see docs/DEPLOY.md for the mailbox setup).
MAIL_TRANSPORT=console
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@loyalstring.com
SMTP_PASS=
MAIL_FROM=LoyalFlow <noreply@loyalstring.com>
SMTP_STARTTLS=1

# Scheduler (SLA checks, KPI snapshots, SOP generation, backups, Monday digest). Keep 1 in production.
SCHEDULER=1
LOG_LEVEL=info

# LoyalHire candidate email (assessment invitations and reminders) through Microsoft 365 / Graph.
# Leave empty and nothing is ever sent to a candidate; assessment invitations stay switched off outside demo mode.
# The app registration needs the Mail.Send application permission, limited to the recruitment mailbox.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
# Encrypts assessment links in the database. Set once and never change it, or links already sent stop working.
# If empty, the session secret in the data folder is used.
ASSESSMENT_LINK_SECRET=
# The address candidates reach the app on. Assessment links are built from it, so it must be the public https address in production.
# BASE_URL=https://loyalflow.example.com

# Reading CVs with Google Gemini. Easier: paste the key under Hiring → Settings in the app (stored encrypted).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
